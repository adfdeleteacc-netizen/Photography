# --- append these to your Laravel .env ---
APP_NAME="RORI"
QUEUE_CONNECTION=redis
CACHE_STORE=redis          # tags (search cache) need a tag-capable store such as redis
SESSION_DRIVER=redis

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1:8000
SESSION_DOMAIN=localhost

# Media (S3-compatible: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO)
MEDIA_DISK=s3
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=                   # CDN base URL if you front the bucket with CloudFront/Cloudflare
AWS_ENDPOINT=              # only for non-AWS providers

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=  # RazorpayX account used for creator payouts

# Marketplace
MARKETPLACE_COMMISSION_PERCENT=20
MARKETPLACE_GST_PERCENT=18
MARKETPLACE_TCS_PERCENT=0.5
MARKETPLACE_STATE_CODE=27   # your GST state code; decides CGST+SGST vs IGST
MARKETPLACE_GSTIN=
SUBSCRIPTION_GRACE_DAYS=5
PAYMENT_HOLD_MINUTES=30

# Bootstrap admin (no default password is shipped)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional realtime chat
BROADCAST_CONNECTION=log   # pusher when enabling Echo
